# Copy to .env and fill in. Never commit .env.
# The batch CLI (npm run evaluate) needs only the LLM keys — no database.

# --- runtime ---
# development | production. production turns on the SSRF guard and Secure cookies.
NODE_ENV=development
# API port.
PORT=4000
# Pino level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- database (API only, not used by the batch CLI) ---
# Local docker:  mongodb://localhost:27017/prepkit
# Atlas:         mongodb+srv://<user>:<pass>@<cluster>/prepkit?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/prepkit

# --- auth (API only) ---
# 32 characters or more. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-at-least-32-random-characters
# Browser origin allowed to call the API directly (CORS). Locally the Next rewrite makes this same-origin.
WEB_ORIGIN=http://localhost:3000

# --- LLM (at least one key is required) ---
# Which provider is tried first. The other one is the fallback.
# Groq leads by default: a five-case batch is ~50 calls, and Google's free tier
# allows 20 generate-content requests per day on a flash model.
LLM_PRIMARY=groq
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Parallel LLM calls. Keep low on free tiers.
LLM_CONCURRENCY=2
# Give up on a single model request after this many ms, then retry or fail over.
LLM_TIMEOUT_MS=60000

# --- retrieval ---
# Optional. Adds web search for interview discussion. https://app.tavily.com
TAVILY_API_KEY=
# Ceiling on paid Tavily searches per process (one credit each). Results are cached
# for a week, in .cache/tavily.json locally, so the same company is only searched once.
TAVILY_MAX_SEARCHES=100
# Max pages fetched per company crawl.
CRAWL_MAX_PAGES=12
# Per-request timeout in ms.
FETCH_TIMEOUT_MS=10000
# Set true only to let the crawler reach localhost/private IPs while NODE_ENV=production.
# Needed if you run the fixture site and the API in production mode on the same box.
ALLOW_PRIVATE_URLS=false

# --- web ---
# Where Next rewrites /api/* to. Render URL in production.
API_URL=http://localhost:4000
